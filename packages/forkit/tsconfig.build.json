{
  // The published build: ESM JavaScript and declarations in dist/, from src/ only.
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  }
}
